# set ft=markdown for okish TS syntax highlighting
src : package_nuvoton_index.json

version : 0.4.7
tool-version : 2.2.0
download-url : https://github.com/is-tg/n76e003-core/releases/download

core : n76e003-core.tar.gz
tool : toolchain-bundle.tar.gz

core-url : `download-url`/v`version`/`core`
tool-url : `download-url`/v`version`/`tool`

raw-core-hash : sha256 ar/`core`
core-hash : SHA-256:`raw-core-hash`
core-size : bytes ar/`core`

raw-tool-hash : sha256 ar/`tool`
tool-hash : SHA-256:`raw-tool-hash`
tool-size : bytes ar/`tool`

# core
src.packages.0.platforms.0.version        : `version`
src.packages.0.platforms.0.url            : `core-url`
src.packages.0.platforms.0.checksum       : `core-hash`
src.packages.0.platforms.0.size           : `core-size`

# tools
src.packages.0.platforms.0.toolsDependencies.0.version : `tool-version`
src.packages.0.tools.0.version : `tool-version`

# linux
src.packages.0.tools.0.systems.0.url      : `tool-url`
src.packages.0.tools.0.systems.0.checksum : `tool-hash`
src.packages.0.tools.0.systems.0.size     : `tool-size`
